{
  "manifest_version": 3,
  "name": "AION Everywhere — Mini-Me CFS1 AI Companion",
  "version": "1.8.0",
  "description": "Peaceful 3D Mini-Me AION (Model 13 Tuxedo Cat) in a 353 KB CosmOS CFS1 capsule. Features 1:1 Multi-Dancer Video Motion-Capture Rigging, Shadow-Cat Clones, Full-Song Choreography Recording, 120B AI Chat & English Neural Voice!",
  "browser_specific_settings": {
    "gecko": {
      "id": "aion-everywhere@cosmos.ai",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://10.43.191.111/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "aion_minime_easter_egg.cfs",
        "aion_minime_easter_egg.js",
        "three.min.js",
        "GLTFLoader.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}